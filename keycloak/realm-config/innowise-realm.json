{
  "id": "innowise-realm",
  "realm": "innowise-realm",
  "displayName": "Innowise Realm",
  "enabled": true,
  "registrationAllowed": true,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "editUsernameAllowed": true,
  "roles": {
    "realm": [
      {
        "id": "admin-role",
        "name": "admin",
        "description": "Administrator role with full access",
        "composite": true,
        "composites": {
          "client": {
            "realm-management": [
              "manage-users",
              "view-users",
              "query-users",
              "view-realm",
              "view-clients"
            ]
          }
        },
        "clientRole": false,
        "containerId": "innowise-realm"
      },
      {
        "id": "user-role",
        "name": "user",
        "description": "Standard user role",
        "composite": false,
        "clientRole": false,
        "containerId": "innowise-realm"
      }
    ]
  },
  "users": [
    {
      "id": "admin-user",
      "username": "admin",
      "enabled": true,
      "email": "admin@innowise.com",
      "firstName": "Admin",
      "lastName": "User",
      "credentials": [
        {
          "type": "password",
          "value": "admin123",
          "temporary": false
        }
      ],
      "requiredActions": [],
      "realmRoles": [
        "admin"
      ]
    },
    {
      "username": "service-account-innowise-client",
      "enabled": true,
      "serviceAccountClientId": "innowise-client",
      "realmRoles": [
        "admin"
      ],
      "clientRoles": {
        "realm-management": [
          "realm-admin"
        ]
      }
    }
  ],
  "clients": [
    {
      "clientId": "innowise-client",
      "name": "Innowise Client",
      "description": "Main client for Innowise services",
      "enabled": true,
      "clientAuthenticatorType": "client-secret",
      "secret": "innowise-secret",
      "redirectUris": [
        "http://localhost:5173/*",
        "http://localhost:5174/*",
        "http://localhost:8080/*",
        "http://localhost:8081/*",
        "http://localhost:8082/*",
        "http://localhost:8086/*",
        "http://localhost:8087/*",
        "http://localhost:8080/swagger-ui/oauth2-redirect.html",
        "http://localhost:8082/swagger-ui/oauth2-redirect.html",
        "http://localhost:8086/swagger-ui/oauth2-redirect.html"
      ],
      "webOrigins": [
        "+",
        "http://localhost:5173",
        "http://localhost:5174",
        "http://localhost:8080",
        "http://localhost:8081",
        "http://localhost:8082",
        "http://localhost:8086",
        "http://localhost:8087",
        "http://localhost:8088"
      ],
      "publicClient": false,
      "protocol": "openid-connect",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": true,
      "authorizationServicesEnabled": true,
      "fullScopeAllowed": true,
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "saml.assertion.signature": "false",
        "saml.multivalued.roles": "false",
        "saml.force.post.binding": "false",
        "saml.encrypt": "false",
        "saml.server.signature": "false",
        "saml.server.signature.keyinfo.ext": "false",
        "exclude.session.state.from.auth.response": "false",
        "saml_force_name_id_format": "false",
        "saml.client.signature": "false",
        "tls.client.certificate.bound.access.tokens": "false",
        "saml.authnstatement": "false",
        "display.on.consent.screen": "false",
        "saml.onetimeuse.condition": "false"
      }
    }
  ],
  "identityProviders": [
    {
      "alias": "google",
      "displayName": "Google",
      "providerId": "google",
      "enabled": true,
      "updateProfileFirstLogin": true,
      "trustEmail": true,
      "storeToken": false,
      "addReadTokenRoleOnCreate": false,
      "authenticateByDefault": false,
      "linkOnly": false,
      "firstBrokerLoginFlowAlias": "registration",
      "config": {
        "useJwksUrl": "true",
        "syncMode": "IMPORT",
        "clientId": "${GOOGLE_CLIENT_ID}",
        "clientSecret": "${GOOGLE_CLIENT_SECRET}",
        "hostedDomain": "",
        "defaultScope": "email profile"
      }
    }
  ]
}