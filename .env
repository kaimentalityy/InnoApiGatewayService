############################################
# PORTS
############################################
API_GATEWAY_PORT=8080
USER_SERVICE_PORT=8082
ORDER_SERVICE_PORT=8086
PAYMENT_SERVICE_PORT=8087
PROMETHEUS_PORT=9091

############################################
# API GATEWAY CONFIG
############################################
SPRING_APPLICATION_NAME=inno-api-gateway
SERVER_PORT=8080
TOKEN_PREFIX=Bearer
AUTH_WHITELIST_PATHS=/auth/login,/auth/register,/auth/refresh
HEADER_USER_ID=X-User-Id
CONTENT_TYPE_JSON=application/json

############################################
# SERVICE INTERNAL URLs (Kubernetes/Docker)
############################################
USER_SERVICE_URI=http://user-service:8082
ORDER_SERVICE_URI=http://order-service:8086
PAYMENT_SERVICE_URI=http://payment-service:8087

