############################################
# MONGODB (Payment Service)
############################################
MONGO_INITDB_ROOT_USERNAME=root
MONGO_INITDB_ROOT_PASSWORD=secret
MONGO_HOST=mongodb
MONGO_PORT=27017
MONGO_DATABASE=payment

############################################
# RANDOM NUMBER API
############################################
