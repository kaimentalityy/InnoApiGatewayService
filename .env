############################################
# PORTS
############################################
API_GATEWAY_PORT=8080
AUTH_SERVICE_PORT=8081
USER_SERVICE_PORT=8082
ORDER_SERVICE_PORT=8086
PAYMENT_SERVICE_PORT=8087

############################################
# API GATEWAY CONFIG
############################################
SPRING_APPLICATION_NAME=inno-api-gateway
SERVER_PORT=8080
TOKEN_PREFIX=Bearer
AUTH_WHITELIST_PATHS=/auth/login,/auth/register,/auth/refresh
HEADER_USER_ID=X-User-Id
CONTENT_TYPE_JSON=application/json

############################################
# SERVICE INTERNAL URLs (Kubernetes/Docker)
############################################
AUTH_SERVICE_URI=http://auth-service:8081
USER_SERVICE_URI=http://user-service:8082
ORDER_SERVICE_URI=http://order-service:8086
PAYMENT_SERVICE_URI=http://payment-service:8087

############################################
# AUTH SERVICE DATABASE
############################################
AUTH_DB_HOST=postgres_auth
AUTH_DB_PORT=5432
AUTH_DB_NAME=auth_db
AUTH_DB_USERNAME=postgres
AUTH_DB_PASSWORD=17052007

############################################
# USER SERVICE DATABASE
############################################
USER_DB_HOST=postgres_user
USER_DB_PORT=5432
USER_DB_NAME=user_db
USER_DB_USERNAME=postgres
USER_DB_PASSWORD=17052007

############################################
# ORDER SERVICE DATABASE
############################################
ORDER_DB_HOST=postgres_order
ORDER_DB_PORT=5432
ORDER_DB_NAME=order_db
ORDER_DB_USERNAME=postgres
ORDER_DB_PASSWORD=17052007

############################################
# PAYMENT SERVICE DATABASE
############################################
PAYMENT_DB_HOST=postgres_payment
PAYMENT_DB_PORT=5432
PAYMENT_DB_NAME=payment_db
PAYMENT_DB_USERNAME=postgres
PAYMENT_DB_PASSWORD=17052007

############################################
# REDIS
############################################
REDIS_HOST=redis
REDIS_PORT=6379

############################################
# MONGODB (Payment Service)
############################################
MONGO_INITDB_ROOT_USERNAME=root
MONGO_INITDB_ROOT_PASSWORD=secret
MONGO_HOST=mongodb
MONGO_PORT=27017
MONGO_DATABASE=payment

############################################
# RANDOM NUMBER API
############################################
RANDOM_API_BASE_URL=https://www.randomnumberapi.com
RANDOM_API_PATH=/api/v1.0/random
RANDOM_API_MIN=100
RANDOM_API_MAX=1000
RANDOM_API_COUNT=1

############################################
# KAFKA CONFIGURATION
############################################
KAFKA_BOOTSTRAP_SERVERS=kafka:29092
KAFKA_ORDER_EVENTS_TOPIC=order-events
KAFKA_PAYMENT_EVENTS_TOPIC=payment-events

############################################
# JWT CONFIG
############################################
JWT_SECRET=MySuperSecretKeyForJWTMySuperSecretKeyForJWT
JWT_EXPIRATION=3600000
JWT_HEADER=Authorization
JWT_TOKEN_PREFIX=Bearer
JWT_ROLE_PREFIX=ROLE_

############################################
# PASSWORD SECURITY CONFIG
############################################
PASSWORD_STRENGTH=16
PASSWORD_HASH_ALGORITHM=SHA-256
PASSWORD_SALT_ALGORITHM=SHA1PRNG
PASSWORD_SALT_LENGTH=16

############################################
# NETWORK
############################################
DOCKER_NETWORK_NAME=innonetwork

############################################
# MINIKUBE (optional)
############################################
MINIKUBE_MEMORY=4096
MINIKUBE_CPUS=2
MINIKUBE_DISK_SIZE=20g
