RANDOM_API_PATH=/api/v1.0/random
RANDOM_API_MIN=100
RANDOM_API_MAX=1000
RANDOM_API_COUNT=1

############################################
# KAFKA CONFIGURATION
############################################
KAFKA_BOOTSTRAP_SERVERS=kafka:29092
KAFKA_ORDER_EVENTS_TOPIC=order-events
KAFKA_PAYMENT_EVENTS_TOPIC=payment-events

############################################
# NETWORK
############################################
DOCKER_NETWORK_NAME=innonetwork

############################################
# MINIKUBE
############################################
